# Copy to .env.local for local development. Only the Google and NextAuth values are required locally;
# without a database connection string and AZURE_STORAGE_* the app uses an in-memory store and inline photos.
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GEMINI_API_KEY=
# Optional: override the Gemini model (default gemini-2.5-flash)
GEMINI_MODEL=
# Optional: per-user dashboard scans per day (default 60)
DAILY_SCAN_LIMIT=
# Production refuses to run without a database unless ALLOW_MEMORY_STORE=true
# MongoDB connection string (Azure Cosmos DB for MongoDB or any MongoDB). MONGODB_URI also works.
AZURE_COSMOS_CONNECTIONSTRING=
# Optional database name (default paytrol)
MONGODB_DATABASE=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=dashboard-photos
# Bearer token required by /api/retention/cleanup
CRON_SECRET=
