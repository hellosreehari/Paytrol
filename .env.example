# Copy to .env.local for local development. Only the Google and NextAuth values are required locally;
# without COSMOS_* and AZURE_STORAGE_* the app uses an in-memory store and inline photos.
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GEMINI_API_KEY=
# Optional: override the Gemini model (default gemini-2.5-flash)
GEMINI_MODEL=
# Optional: per-user dashboard scans per day (default 60)
DAILY_SCAN_LIMIT=
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE=paytrol
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=dashboard-photos
# Bearer token required by /api/retention/cleanup
CRON_SECRET=
